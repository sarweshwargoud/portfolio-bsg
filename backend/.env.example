# Supabase Project Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# RAG Configuration
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSION=768
LLM_MODEL=gemini-2.5-flash

# Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,https://portfolio-bsg.onrender.com

# Gmail API OAuth 2.0 Configuration (Scope: https://www.googleapis.com/auth/gmail.send)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REFRESH_TOKEN=your_oauth_refresh_token_here
GMAIL_SENDER_EMAIL=your_email@gmail.com
GMAIL_NOTIFICATION_EMAIL=your_email@gmail.com
PORTFOLIO_URL=https://your-portfolio-url.com
